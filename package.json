{
  "name": "actual-budget-api",
  "version": "0.1.0",
  "description": "Node.js application for extracting, analyzing, and updating Actual Budget data via API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "actual-budget",
    "finance",
    "budgeting",
    "api",
    "data-analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actual-app/api": "^6.0.0",
    "@anthropic-ai/sdk": "^0.95.1",
    "chalk": "^5.6.2",
    "minimist": "^1.2.8",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
