# ── Actual Budget connection ───────────────────────────────────────────────────
# Option A: Server-based
ACTUAL_SERVER_URL=http://localhost:5006
ACTUAL_PASSWORD=your_password_here
ACTUAL_SYNC_ID=your_sync_id_here

# Option B: File-based (local budget directory)
# ACTUAL_DATA_DIR=./actual-data

# ── AI backend ─────────────────────────────────────────────────────────────────
# 'anthropic' or 'ollama'
AI_BACKEND=ollama

# Anthropic Claude (when AI_BACKEND=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-7

# Ollama (when AI_BACKEND=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Behaviour ──────────────────────────────────────────────────────────────────
# DRY_RUN=true means no writes unless --confirm flag is passed
DRY_RUN=true

# How many days back to look for uncategorized transactions
LOOKBACK_DAYS=90

# Maximum rules per AI request (batching)
AI_MAX_RULES_PER_REQUEST=20
